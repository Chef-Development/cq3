{
  "name": "cq3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "screens": "playwright test screens",
    "screens:update": "playwright test screens --update-snapshots",
    "balance": "vitest run --config vitest.balance.config.ts tests/balance/balance.run.ts",
    "calibrate": "vitest run --config vitest.balance.config.ts tests/balance/calibrate.run.ts",
    "retarget": "vitest run --config vitest.balance.config.ts tests/balance/retarget.run.ts",
    "twin": "vitest run --config vitest.balance.config.ts tests/balance/twin.run.ts",
    "snowball": "vitest run --config vitest.balance.config.ts tests/balance/snowball.run.ts",
    "perks": "vitest run --config vitest.balance.config.ts tests/balance/perks.run.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
